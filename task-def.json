{
  "family": "trade-executor-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::885922397350:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "trade-executor",
      "image": "885922397350.dkr.ecr.eu-central-1.amazonaws.com/trade-executor:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "POSTGRES_DSN", "value": "postgres://trader:trader123@trade-executor-db.cz648o4osyxr.eu-central-1.rds.amazonaws.com:5432/tradedb?sslmode=require"},
        {"name": "REDIS_ADDR", "value": "trade-executor-redis.df5uvi.0001.euc1.cache.amazonaws.com:6379"},
        {"name": "KAFKA_BROKER", "value": "PLACEHOLDER_UNTIL_MSK_STEP"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/trade-executor",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}